ENVIRONMENT=staging
DATABASE_URL=C:\stetiapp-private-data\stetiapp-staging.sqlite3
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=estetica-api
FRONTEND_ORIGINS=https://staging.example.invalid
BACKUP_DIR=C:\stetiapp-private-backups
BACKUP_RETENTION_DAYS=30
LOG_LEVEL=INFO
DEBUG=false
# Solo para ejecutar backend/app/smoke.py contra el staging ya levantado.
API_BASE_URL=https://api-staging.example.invalid
FRONTEND_URL=https://staging.example.invalid
STAGING_SMOKE_STUDIO_ID=staging-example-studio
STAGING_SMOKE_TOKEN=replace-with-a-short-lived-test-token
